# Maximum number of nodes the graph will lay out. Above this the editor shows a
# "not supported" panel instead of rendering.
#
# 1200 is the value this guard was validated against. Raising it removes the only
# protection against a huge document locking up or OOM-ing the browser tab, and
# because the document is restored from the persisted editor session, a reload
# re-triggers the hang. Measure before increasing it.
NEXT_PUBLIC_NODE_LIMIT=1200

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Turns off the upstream-hosted promo surfaces: the external-mode dialog, the
# "Upgrade to Pro Editor" toolbar link, and the "Choose your editor" onboarding
# modal. Set to false to get all three back.
NEXT_PUBLIC_DISABLE_EXTERNAL_MODE=true

# Google Analytics measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public base URL of this deployment. Drives the sitemap, robots.txt, and every
# page's canonical and Open Graph URL, so a self-hosted instance should set it to
# its own origin.
NEXT_PUBLIC_SITE_URL=https://jsoncrack.com
