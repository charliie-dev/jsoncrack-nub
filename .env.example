# Compose interpolation only. App variables live in apps/www/.env.

# Host port published by Docker Compose
PORT=8080

# Tag of the published image that `docker compose pull` fetches
TAG=latest

# Public base URL of this deployment, passed to the build as an arg. Drives the
# sitemap, robots.txt, and every page's canonical and Open Graph URL.
NEXT_PUBLIC_SITE_URL=https://jsoncrack.com

# Node ceiling for the graph, passed to the build as an arg. Leave it commented out
# to keep the apps/www/.env default. Setting it here only takes effect on a rebuild
# (`docker compose up -d --build`): the app is a static export, so the value is
# inlined into the bundle at build time and a pulled image already carries its own.
# NEXT_PUBLIC_NODE_LIMIT=100000
